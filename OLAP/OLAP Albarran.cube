  <MdxScripts>
    <MdxScript dwd:design-time-name="133e8978-bb56-4ce2-ae16-d37ad69ea7df">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T03:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T03:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;   
CREATE MEMBER CURRENTCUBE.[Measures].[Ventas Mes Anterior]
 AS (
  [Measures].[Monto Neto],
  ParallelPeriod(
    [D Tiempo].[Calendario].[Mes],
    1,
    [D Tiempo].[Calendario].CurrentMember
  )
), 
FORMAT_STRING = "Currency", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Ventas Año Anterior]
 AS (
  [Measures].[Monto Neto],
  ParallelPeriod(
    [D Tiempo].[Calendario].[Año],
    1,
    [D Tiempo].[Calendario].CurrentMember
  )
), 
FORMAT_STRING = "Currency", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Crecimiento Ventas MoM]
 AS IIF(
  IsEmpty([Measures].[Ventas Mes Anterior]) OR [Measures].[Ventas Mes Anterior] = 0,
  NULL,
  ([Measures].[Monto Neto] - [Measures].[Ventas Mes Anterior]) / [Measures].[Ventas Mes Anterior]
), 
FORMAT_STRING = "Percent", 
NON_EMPTY_BEHAVIOR = { [Monto Neto] }, 
VISIBLE = 1; 
CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio]
 AS IIF(
  IsEmpty([Measures].[Documentos Count]) OR [Measures].[Documentos Count] = 0,
  NULL,
  [Measures].[Monto Neto] / [Measures].[Documentos Count]
), 
FORMAT_STRING = "Currency", 
NON_EMPTY_BEHAVIOR = { [Monto Neto] }, 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Porcentaje Descuento]
 AS IIF(
  IsEmpty([Measures].[Monto Bruto]) OR [Measures].[Monto Bruto] = 0,
  NULL,
  [Measures].[Descuento] / [Measures].[Monto Bruto]
), 
FORMAT_STRING = "Percent", 
NON_EMPTY_BEHAVIOR = { [Monto Neto] }, 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>